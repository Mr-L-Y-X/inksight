# InkSight 生产环境配置（backend）
# 用法：cp deploy/backend.env backend/.env  → 填 ADMIN_TOKEN / API Key → 重启进程
# 说明：backend/.env 被 .gitignore 忽略，本文件是它的版本化模板，换服务器只改这里

# ---------- 必填 ----------
# 注：当前代码的数据库路径由 core/db.py 按 backend/ 目录硬算（backend/inksight.db），
# 不读 DB_PATH，写在这里只为兼容旧版；换盘符/目录请改代码或用软链。
# 生成：openssl rand -hex 16；留空 = 管理接口无鉴权
ADMIN_TOKEN=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---------- 域名相关（换域名时改这两行，注意带协议、不带结尾斜杠）----------
INKSIGHT_ALLOWED_HOSTS=inksight.lanyx.online
INKSIGHT_CORS_ORIGINS=https://inksight.lanyx.online

# ---------- 内容 ----------
DEFAULT_CITY=杭州

# ---------- 渲染（与 backend/.env.example 推荐值一致，别随意调）----------
INKSIGHT_FONT_ENGINE=bitmap
INKSIGHT_BITMAP_MAX_REQUEST_SIZE=28
INKSIGHT_BITMAP_MAX_SIZE_DELTA=3
INKSIGHT_648_COMPONENT_SCALE_MAX=1.35

# ---------- 上传图缓存 ----------
INKSIGHT_UPLOADS_MAX_AGE_DAYS=30
INKSIGHT_UPLOADS_MAX_TOTAL_MB=512
